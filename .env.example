# 数据库（开发 / 生产共用变量名；勿把生产密码提交进 git）
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=pgwhite

# 迁移 / seed 写远端（Railway）时必须显式设为 1
# MIGRATE_ALLOW_REMOTE=1

# Sprint 1A：在 production 构建中启用 /api/dev/* 数据模型证明接口（默认关）
# DEV_DATA_TOOLS=1

# EL2 human study: required to export results (CSV/JSON), at least 32 chars. Never commit the real token.
# EL2_HS_EXPORT_TOKEN=
# EL2 optional switches (see research/.../el2/human-study/SECURITY.md). Unset = safe defaults.
# EL2_HS_ALLOW_TEST_MODE=1        # memory-only test mode on Preview / local production builds; ignored on Vercel Production
# EL2_HS_ALLOW_PREVIEW_STUDY=1    # study mode on Vercel Preview; only with a non-production preview DB
# EL2_HS_RATE_LIMIT_PER_CLIENT=20
# EL2_HS_RATE_LIMIT_GLOBAL=300
# EL2_HS_RATE_LIMIT_WINDOW_SECONDS=600
# EL2 private dataset on hosts without the gitignored files (Vercel): gzip+Base64 of the internal master
# and DATASET-MANIFEST.json, produced by scripts/el2hs-encode-dataset.ps1. Set both or neither.
# EL2_HS_DATASET_BASE64=
# EL2_HS_MANIFEST_BASE64=

# 微信读书 Agent API（仅本地 generate-weread-import 脚本使用，勿提交真实 key）
# 这是 Import（外部划线进入 PGWhite），不是 Favorite/收藏
WEREAD_API_KEY=
