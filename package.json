{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "import:weread": "node scripts/generate-weread-import.mjs",
    "import:weread:batch": "node scripts/generate-weread-batch-import.mjs",
    "typecheck": "nuxt typecheck",
    "db:migrate": "node scripts/migrate.mjs up",
    "db:migrate:status": "node scripts/migrate.mjs status",
    "db:migrate:mark": "node scripts/migrate.mjs mark",
    "db:migrate:new": "node scripts/migrate.mjs new",
    "db:seed:dev-users": "node scripts/seed-dev-users.mjs",
    "db:proof:import": "node scripts/proof-import-foundation.mjs",
    "research:dedup:export-seeds": "node --experimental-strip-types --import ./tests/ts-resolve-hook.mjs research/dedup-benchmark/scripts/export-seeds.mjs",
    "research:dedup:generate": "node --experimental-strip-types --import ./tests/ts-resolve-hook.mjs research/dedup-benchmark/scripts/generate-cases.mjs",
    "research:dedup:benchmark": "node --experimental-strip-types --import ./tests/ts-resolve-hook.mjs research/dedup-benchmark/scripts/run-benchmark.mjs",
    "research:dedup:dry-run": "node --experimental-strip-types --import ./tests/ts-resolve-hook.mjs research/dedup-benchmark/scripts/dry-run.mjs",
    "research:annotation:export-snapshot": "node research/annotation-workbench/scripts/export-readonly-snapshot.mjs",
    "research:annotation:export-fixture": "node research/annotation-workbench/scripts/export-fixture.mjs",
    "research:annotation:dry-run": "node --experimental-strip-types --import ./tests/ts-resolve-hook.mjs research/annotation-workbench/scripts/dry-run-mock.mjs",
    "research:annotation:free-concepts": "node --experimental-strip-types --import ./tests/ts-resolve-hook.mjs research/annotation-workbench/scripts/run-free-concepts-live.mjs",
    "research:taglib:ingest-lto": "node research/tag-library/scripts/ingest-lto.mjs",
    "research:taglib:build": "python3 research/tag-library/scripts/build-atomic-library.py",
    "research:taglib:test": "node --test research/tag-library/tests/*.test.mjs",
    "research:retrieval:run": "node research/retrieval/runner/scripts/run-retrieval-benchmark.mjs",
    "research:retrieval:validate-calib": "node research/retrieval/runner/scripts/validate-calibration.mjs",
    "research:retrieval:test": "node --test research/retrieval/tests/*.test.mjs",
    "test": "node --experimental-strip-types --import ./tests/ts-resolve-hook.mjs --test tests/unit/*.test.ts tests/unit/*.test.mjs research/tag-library/tests/*.test.mjs research/retrieval/tests/*.test.mjs"
  },
  "dependencies": {
    "@nuxt/ui": "^4.0.1",
    "@nuxtjs/i18n": "^10.1.0",
    "@vercel/analytics": "^1.5.0",
    "mysql2": "^3.19.1",
    "nuxt": "^4.1.2",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vue-tsc": "2.2.12"
  }
}
