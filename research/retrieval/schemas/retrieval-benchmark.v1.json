{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pgwhite.local/research/retrieval/schemas/retrieval-benchmark.v1.json",
  "title": "PGWhite retrieval benchmark fixture (research)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_version", "quotes"],
  "properties": {
    "schema_version": { "const": "retrieval-benchmark.v1" },
    "benchmark_version": {
      "type": "string",
      "description": "Human/fixture version id, e.g. synthetic-smoke.v1 or calib-zh-themes.v1"
    },
    "created_at": { "type": "string" },
    "research_only": { "type": "boolean" },
    "exploratory": {
      "type": "boolean",
      "description": "When true, fixture has no calibration ground truth; Recall@K is not interpretable."
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "quotes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["quote_id", "text_zh"],
        "properties": {
          "quote_id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable research Quote id/reference (not necessarily production quotes.id)."
          },
          "text_zh": {
            "type": "string",
            "minLength": 1
          },
          "source": { "type": "string" },
          "category": { "type": "string" },
          "expected_theme_ids": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Expected canonical Theme research IDs. Empty/absent = unevaluated."
          },
          "expected_theme_labels": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Optional expected canonical labels (resolved against library when ids omitted)."
          },
          "ambiguity_flags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
