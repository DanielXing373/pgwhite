{
  "schema_version": "retrieval-config.v1",
  "config_id": "default-retrieval-v1",
  "research_only": true,
  "dimension": "theme",
  "tag_library_path": "research/tag-library/data/library/atomic-tag-library.v1.json",
  "active_status": "active_candidate",
  "benchmark_path": "research/retrieval/benchmark/fixtures/synthetic-smoke.v1.json",
  "representation": "A",
  "provider": {
    "id": "fake",
    "options": {
      "dimensions": 32
    }
  },
  "ranking": {
    "top_k_report": [5, 10, 20],
    "store_full_ranking": true
  },
  "deterministic_match": {
    "enabled": true,
    "method": "exact_substring",
    "notes": [
      "Conservative Chinese exact substring of canonical/alias forms.",
      "Short surfaces (len < 2) are recorded with caution_short_surface=true; no fuzzy/NLP."
    ]
  },
  "runs_dir": "research/retrieval/runs",
  "overwrite_completed_runs": false
}
